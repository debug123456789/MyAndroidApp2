<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nexshizuku.service">

    <!-- Service-only manifest, permissions declared in app manifest -->

    <application>
        <service
            android:name=".NexShizukuService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.BIND_FOREGROUND_SERVICE"
            android:process=":service">
            <intent-filter>
                <action android:name="com.nexshizuku.SERVICE" />
            </intent-filter>
        </service>
    </application>

</manifest>
